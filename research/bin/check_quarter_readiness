#!/usr/bin/env ruby

year = ARGV[0]&.to_i
quarter = ARGV[1]&.to_i

unless year && (1..4).include?(quarter)
  warn "Usage: bundle exec rails runner research/bin/check_quarter_readiness YEAR QUARTER"
  exit 2
end

report_month = quarter * 3
report_date = Date.new(year, report_month, -1)

previous_date =
  if quarter == 1
    Date.new(year - 1, 12, 31)
  else
    Date.new(year, (quarter - 1) * 3, -1)
  end

puts "DATA_READINESS_BEGIN"
puts "portfolio_period=#{year}-Q#{quarter}"
puts "report_date=#{report_date}"
puts "comparison_date=#{previous_date}"

# ------------------------------------------------------------
# 1. Current-quarter filing universe
# ------------------------------------------------------------

current = ThirteenF.where(report_date: report_date)
current_latest = current.where(restated_by_id: nil)

current_count = current_latest.count
current_value_count = current_latest.where.not(holdings_value_reported: nil).count

puts "current_filings=#{current_count}"
puts "current_filings_with_reported_value=#{current_value_count}"

if current_count.zero?
  puts "gate_status=FAILED"
  puts "failure_reason=NO_CURRENT_QUARTER_FILING_UNIVERSE"
  puts "DATA_READINESS_END"
  exit 10
end

# ------------------------------------------------------------
# 2. Previous-quarter comparison universe
# ------------------------------------------------------------

previous = ThirteenF.where(
  report_date: previous_date,
  restated_by_id: nil
)

previous_count = previous.count

puts "previous_filings=#{previous_count}"

if previous_count.zero?
  puts "gate_status=FAILED"
  puts "failure_reason=NO_PREVIOUS_QUARTER_COMPARISON_UNIVERSE"
  puts "DATA_READINESS_END"
  exit 11
end

# ------------------------------------------------------------
# 3. Holdings availability
# ------------------------------------------------------------

current_with_holdings =
  current_latest
    .joins(:holdings)
    .distinct
    .count

previous_with_holdings =
  previous
    .joins(:holdings)
    .distinct
    .count

puts "current_filings_with_holdings=#{current_with_holdings}"
puts "previous_filings_with_holdings=#{previous_with_holdings}"

if current_with_holdings.zero?
  puts "gate_status=FAILED"
  puts "failure_reason=NO_CURRENT_QUARTER_HOLDINGS"
  puts "DATA_READINESS_END"
  exit 12
end

if previous_with_holdings.zero?
  puts "gate_status=FAILED"
  puts "failure_reason=NO_PREVIOUS_QUARTER_HOLDINGS"
  puts "DATA_READINESS_END"
  exit 13
end

# ------------------------------------------------------------
# 4. Disclosure exceptions
# ------------------------------------------------------------

confidential_count =
  current_latest.where(confidential_omitted: true).count

puts "confidential_treatment_filings=#{confidential_count}"

# ------------------------------------------------------------
# 5. Basic universe sanity
# ------------------------------------------------------------

value_coverage =
  if current_count.positive?
    (current_value_count.to_f / current_count * 100.0)
  else
    0.0
  end

puts "reported_value_coverage_pct=#{value_coverage.round(2)}"

if value_coverage < 90.0
  puts "gate_status=FAILED"
  puts "failure_reason=INSUFFICIENT_REPORTED_VALUE_COVERAGE"
  puts "DATA_READINESS_END"
  exit 14
end

# ------------------------------------------------------------
# PASS
# ------------------------------------------------------------

puts "gate_status=PASSED"
puts "DATA_READINESS_END"
exit 0
