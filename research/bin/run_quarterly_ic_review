#!/usr/bin/env bash

set -Eeuo pipefail

YEAR="${1:-}"
QUARTER="${2:-}"

if [[ -z "$YEAR" || -z "$QUARTER" ]]; then
  echo "Usage: research/bin/run_quarterly_ic_review YEAR QUARTER"
  echo "Example: research/bin/run_quarterly_ic_review 2026 2"
  exit 1
fi

if [[ ! "$YEAR" =~ ^[0-9]{4}$ ]]; then
  echo "ERROR: YEAR must be a four-digit year."
  exit 1
fi

if [[ ! "$QUARTER" =~ ^[1-4]$ ]]; then
  echo "ERROR: QUARTER must be 1, 2, 3 or 4."
  exit 1
fi

export YEAR
export QUARTER

OUTPUT_DIR="research/output/${YEAR}-Q${QUARTER}"
LOG_DIR="${OUTPUT_DIR}/logs"

mkdir -p "$LOG_DIR"

PIPELINE_START=$(date +%s)
PIPELINE_CLOCK=$(date '+%H:%M:%S')
GIT_REVISION=$(git rev-parse --short HEAD 2>/dev/null || echo "UNKNOWN")
BRANCH=$(git branch --show-current 2>/dev/null || echo "UNKNOWN")

BOLD='\033[1m'
DIM='\033[2m'
GREEN='\033[32m'
CYAN='\033[36m'
YELLOW='\033[33m'
RED='\033[31m'
RESET='\033[0m'

line() {
  printf '%*s\n' 72 '' | tr ' ' '─'
}

elapsed_seconds() {
  local start="$1"
  local end
  end=$(date +%s)
  echo $((end - start))
}

format_elapsed() {
  local seconds="$1"
  printf "%02d:%02d" $((seconds / 60)) $((seconds % 60))
}

stage() {
  local number="$1"
  local name="$2"
  local description="$3"
  local script="$4"
  local validation_1="$5"
  local validation_2="$6"
  local log_file="${LOG_DIR}/$(printf '%02d' "$number")_$(basename "$script" .rb).log"

  local started
  started=$(date +%s)

  echo
  printf "${BOLD}${CYAN}[%02d/10] %-43s${RESET}\n" "$number" "$name"
  printf "        ${DIM}%s${RESET}\n" "$description"
  printf "        Initializing analytical stage...\n"

  if bundle exec rails runner "$script" "$YEAR" "$QUARTER" \
      >"$log_file" 2>&1; then

    local seconds
    seconds=$(elapsed_seconds "$started")

    printf "        ${GREEN}✓${RESET} %s\n" "$validation_1"
    printf "        ${GREEN}✓${RESET} %s\n" "$validation_2"
    printf "        ${GREEN}✓${RESET} Analytical output persisted\n"
    printf "        ${DIM}Audit log: %s${RESET}\n" "$log_file"
    printf "        ${BOLD}${GREEN}COMPLETED${RESET} %44s\n" "$(format_elapsed "$seconds")"
  else
    local seconds
    seconds=$(elapsed_seconds "$started")

    echo
    printf "        ${RED}${BOLD}ANALYTICAL STAGE FAILED${RESET}\n"
    printf "        Stage:   %s\n" "$name"
    printf "        Elapsed: %s\n" "$(format_elapsed "$seconds")"
    printf "        Log:     %s\n" "$log_file"
    echo
    printf "${YELLOW}Last 30 lines of diagnostic output:${RESET}\n"
    echo
    tail -30 "$log_file"
    echo
    exit 1
  fi
}

clear

printf "${BOLD}"
echo "╔══════════════════════════════════════════════════════════════════════╗"
echo "║        INSTITUTIONAL CAPITAL INTELLIGENCE ENGINE                   ║"
echo "║        Quarterly Capital Allocation Research Pipeline              ║"
echo "╚══════════════════════════════════════════════════════════════════════╝"
printf "${RESET}"

echo
printf " PORTFOLIO PERIOD     ${BOLD}Q%s %s${RESET}\n" "$QUARTER" "$YEAR"
printf " RESEARCH STACK       10 analytical models\n"
printf " METHODOLOGY          Security → Manager → Mandate → Portfolio → IC\n"
printf " GIT REVISION         %s\n" "$GIT_REVISION"
printf " BRANCH               %s\n" "$BRANCH"
printf " PIPELINE START       %s\n" "$PIPELINE_CLOCK"
printf " OUTPUT               %s\n" "$OUTPUT_DIR"
printf " AUDIT LOGS           %s\n" "$LOG_DIR"

echo
line

# -------------------------------------------------------------------
# PHASE 0 — DATA READINESS & CONTROL GATE
# -------------------------------------------------------------------

printf "${BOLD} PHASE 0 — DATA READINESS & CONTROL GATE${RESET}\n"
printf "${DIM} Verifying analytical prerequisites before capital intelligence is generated.${RESET}\n"
echo

READINESS_START=$(date +%s)
READINESS_LOG="${LOG_DIR}/00_data_readiness.log"

printf "        Checking quarterly disclosure universe...\n"

if bundle exec rails runner research/bin/check_quarter_readiness "$YEAR" "$QUARTER" \
    >"$READINESS_LOG" 2>&1; then

  CURRENT_FILINGS=$(grep '^current_filings=' "$READINESS_LOG" | cut -d= -f2)
  VALUE_COVERAGE=$(grep '^reported_value_coverage_pct=' "$READINESS_LOG" | cut -d= -f2)
  CURRENT_HOLDINGS=$(grep '^current_filings_with_holdings=' "$READINESS_LOG" | cut -d= -f2)
  PREVIOUS_HOLDINGS=$(grep '^previous_filings_with_holdings=' "$READINESS_LOG" | cut -d= -f2)
  CONFIDENTIAL=$(grep '^confidential_treatment_filings=' "$READINESS_LOG" | cut -d= -f2)

  printf "        ${GREEN}✓${RESET} Quarterly filing universe detected"
  [[ -n "$CURRENT_FILINGS" ]] && printf " (%s filings)" "$CURRENT_FILINGS"
  printf "\n"

  printf "        ${GREEN}✓${RESET} Reported-value coverage"
  [[ -n "$VALUE_COVERAGE" ]] && printf " %s%%" "$VALUE_COVERAGE"
  printf "\n"

  printf "        ${GREEN}✓${RESET} Current-quarter holdings evidence available"
  [[ -n "$CURRENT_HOLDINGS" ]] && printf " (%s filings)" "$CURRENT_HOLDINGS"
  printf "\n"

  printf "        ${GREEN}✓${RESET} Prior-quarter comparison evidence available"
  [[ -n "$PREVIOUS_HOLDINGS" ]] && printf " (%s filings)" "$PREVIOUS_HOLDINGS"
  printf "\n"

  if [[ -n "$CONFIDENTIAL" && "$CONFIDENTIAL" != "0" ]]; then
    printf "        ${YELLOW}⚠${RESET} Confidential-treatment disclosures identified (%s)\n" "$CONFIDENTIAL"
    printf "          ${DIM}Retained for downstream disclosure-quality controls.${RESET}\n"
  else
    printf "        ${GREEN}✓${RESET} No confidential-treatment disclosures identified\n"
  fi

  READINESS_SECONDS=$(elapsed_seconds "$READINESS_START")

  printf "\n"
  printf "        ${GREEN}${BOLD}DATA READINESS GATE: PASSED${RESET}\n"
  printf "        ${DIM}Audit log: %s${RESET}\n" "$READINESS_LOG"
  printf "        ${BOLD}${GREEN}COMPLETED${RESET} %44s\n" "$(format_elapsed "$READINESS_SECONDS")"

else
  READINESS_SECONDS=$(elapsed_seconds "$READINESS_START")
  FAILURE_REASON=$(grep '^failure_reason=' "$READINESS_LOG" | cut -d= -f2 || true)

  printf "\n"
  printf "        ${RED}${BOLD}DATA READINESS GATE: FAILED${RESET}\n"

  if [[ -n "$FAILURE_REASON" ]]; then
    printf "        Control exception: %s\n" "$FAILURE_REASON"
  fi

  printf "        Portfolio period: Q%s %s\n" "$QUARTER" "$YEAR"
  printf "        Audit log: %s\n" "$READINESS_LOG"
  printf "        Elapsed: %s\n" "$(format_elapsed "$READINESS_SECONDS")"

  echo
  printf "${YELLOW} ANALYTICAL PIPELINE NOT STARTED${RESET}\n"
  printf " The requested quarter has not passed the minimum data-readiness controls.\n"
  printf " Prepare or acquire the required SEC data before running institutional analytics.\n"
  echo
  exit 1
fi

echo
line

printf "${BOLD} PHASE I — INSTITUTIONAL CAPITAL ANALYTICS${RESET}\n"
printf "${DIM} Building the observable capital and manager evidence base.${RESET}\n"

stage 1 \
  "CAPITAL UNIVERSE" \
  "Mapping observable institutional capital and distribution..." \
  "research/reports/01_capital_universe.rb" \
  "Reporting universe resolved" \
  "Capital distribution and percentiles calculated"

stage 2 \
  "CAPITAL CONCENTRATION" \
  "Measuring institutional control and capital coverage..." \
  "research/reports/02_capital_concentration.rb" \
  "Concentration structure calculated" \
  "Capital coverage thresholds resolved"

stage 3 \
  "MANAGER UNIVERSE" \
  "Ranking institutions and constructing research universes..." \
  "research/reports/03_manager_universe.rb" \
  "Manager hierarchy constructed" \
  "Research universes segmented"

stage 4 \
  "MANAGER ARCHITECTURE" \
  "Resolving portfolio structure and effective concentration..." \
  "research/reports/04_manager_architecture.rb" \
  "Portfolio architecture calculated" \
  "Concentration and effective positions resolved"

echo
line
printf "${BOLD} PHASE II — DECISION RECONSTRUCTION${RESET}\n"
printf "${DIM} Reconstructing manager behavior and institutional evidence.${RESET}\n"

stage 5 \
  "MANAGER BEHAVIOR" \
  "Reconstructing quarterly portfolio decisions..." \
  "research/reports/05_manager_behavior.rb" \
  "NEW / ADD / REDUCE / EXIT decisions classified" \
  "Disclosure-quality controls applied"

stage 6 \
  "MANAGER INTELLIGENCE" \
  "Integrating capital importance and interpretability..." \
  "research/reports/06_manager_signals.rb" \
  "Manager context integrated" \
  "Research readiness resolved"

stage 7 \
  "SECURITY SIGNALS" \
  "Aggregating institutional accumulation and distribution..." \
  "research/reports/07_security_signals.rb" \
  "Cross-manager evidence aggregated" \
  "Fundamental and broad evidence separated"

echo
line
printf "${BOLD} PHASE III — REGIONAL & IC INTELLIGENCE${RESET}\n"
printf "${DIM} Reconciling GCC evidence with global institutional behavior.${RESET}\n"

stage 8 \
  "REGIONAL CAPITAL INTELLIGENCE" \
  "Resolving GCC and Iraq institutional evidence..." \
  "research/reports/08_regional_institutional_capital.rb" \
  "Regional institutional cohort analyzed" \
  "Portfolio materiality calculated"

stage 9 \
  "GLOBAL × REGIONAL IC REVIEW" \
  "Reconciling evidence and constructing escalation queues..." \
  "research/reports/09_global_regional_ic_review.rb" \
  "Global / regional evidence reconciled" \
  "Research and risk escalations classified"

echo
line
printf "${BOLD} PHASE IV — CAPITAL GOVERNANCE${RESET}\n"
printf "${DIM} Converting evidence into an Investment Committee decision record.${RESET}\n"

stage 10 \
  "CAPITAL ALLOCATION & IC BRIEF" \
  "Synthesizing quarterly evidence for capital governance..." \
  "research/reports/10_quarterly_capital_allocation_brief.rb" \
  "Investment Committee questions evaluated" \
  "Capital-allocation posture established"

echo
printf "${BOLD}${CYAN}[PDF]   INVESTMENT COMMITTEE DECISION ARTIFACT${RESET}\n"
printf "        Rendering governed quarterly brief...\n"

PDF_START=$(date +%s)
PDF_LOG="${LOG_DIR}/10_pdf_render.log"

if [[ -x ".venv-pdf/bin/python" ]]; then
  if YEAR="$YEAR" QUARTER="$QUARTER" \
      .venv-pdf/bin/python research/reports/render_10_ic_brief.py \
      >"$PDF_LOG" 2>&1; then

    printf "        ${GREEN}✓${RESET} Presentation-layer datasets loaded\n"
    printf "        ${GREEN}✓${RESET} IC document assembled\n"

    if [[ -f "$OUTPUT_DIR/10_quarterly_capital_allocation_brief.pdf" ]]; then
      PDF_SIZE=$(du -h "$OUTPUT_DIR/10_quarterly_capital_allocation_brief.pdf" | awk '{print $1}')
      printf "        ${GREEN}✓${RESET} PDF validated (%s)\n" "$PDF_SIZE"
    fi
  else
    printf "        ${RED}✗ PDF rendering failed${RESET}\n"
    tail -20 "$PDF_LOG"
    exit 1
  fi
else
  printf "        ${YELLOW}⚠ PDF environment unavailable${RESET}\n"
  printf "        Expected: .venv-pdf/bin/python\n"
fi

PDF_SECONDS=$(elapsed_seconds "$PDF_START")
printf "        ${BOLD}${GREEN}COMPLETED${RESET} %44s\n" "$(format_elapsed "$PDF_SECONDS")"

TOTAL_SECONDS=$(elapsed_seconds "$PIPELINE_START")

echo
line
printf "${BOLD}${GREEN} QUARTERLY RESEARCH CYCLE COMPLETE${RESET}\n"
line
echo

printf " Portfolio period        Q%s %s\n" "$QUARTER" "$YEAR"
printf " Analytical stages       ${GREEN}10 / 10${RESET}\n"
printf " Pipeline status          ${GREEN}${BOLD}VALIDATED${RESET}\n"
printf " Methodology revision     %s\n" "$GIT_REVISION"

if [[ -f "$OUTPUT_DIR/10_research_queue.csv" ]]; then
  QUEUE_COUNT=$(($(wc -l < "$OUTPUT_DIR/10_research_queue.csv") - 1))
  printf " Research escalations     %s\n" "$QUEUE_COUNT"
fi

if [[ -f "$OUTPUT_DIR/10_capital_allocation_summary.csv" ]]; then
  PRIORITY_RESEARCH=$(awk -F, '$1=="priority_research"{print $2}' \
    "$OUTPUT_DIR/10_capital_allocation_summary.csv" | tr -d '\r')
  PRIORITY_RISK=$(awk -F, '$1=="priority_risk_review"{print $2}' \
    "$OUTPUT_DIR/10_capital_allocation_summary.csv" | tr -d '\r')
  DIVERGENCE=$(awk -F, '$1=="divergence_review"{print $2}' \
    "$OUTPUT_DIR/10_capital_allocation_summary.csv" | tr -d '\r')

  [[ -n "$PRIORITY_RESEARCH" ]] && printf " Priority research        %s\n" "$PRIORITY_RESEARCH"
  [[ -n "$PRIORITY_RISK" ]] && printf " Priority risk review     %s\n" "$PRIORITY_RISK"
  [[ -n "$DIVERGENCE" ]] && printf " Divergence review        %s\n" "$DIVERGENCE"
fi

printf " Total elapsed            %s\n" "$(format_elapsed "$TOTAL_SECONDS")"

echo
printf "${BOLD} INVESTMENT COMMITTEE BRIEF${RESET}\n"
printf " %s/10_quarterly_capital_allocation_brief.pdf\n" "$OUTPUT_DIR"

echo
printf "${BOLD} CAPITAL GOVERNANCE STATE${RESET}\n"
printf " ${CYAN}RESEARCH → UNDERWRITE → GOVERN → ALLOCATE${RESET}\n"
echo
printf "${DIM} Institutional-flow evidence does not authorize automatic capital deployment.${RESET}\n"
echo
